# ── LLM Provider ──────────────────────────────────────────────
# Options: local | minimax
LLM_PROVIDER=local

# ── Local (Ollama) ─────────────────────────────────────────────
OLLAMA_MODEL=mistral:7b
# OLLAMA_MODEL=llama3:70b        # producción (RTX 5070)

# ── Cloud (MiniMax-M2.5) ───────────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.5

# ── Whisper (ASR) ──────────────────────────────────────────────
WHISPER_MODEL=medium             # dev: medium | prod: large-v2
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8        # dev: int8   | prod: float16

# ── Paralelización FFmpeg ──────────────────────────────────────
MAX_WORKERS=2                    # RTX 3060: 2 | RTX 5070: 4-6

# ── Branding ──────────────────────────────────────────────────
STREAMER_NAME=NombreDelStreamer
CHANNEL_HANDLE=@tucanal

# ── Paths ─────────────────────────────────────────────────────
CACHE_DIR=./cache
OUTPUT_DIR=./output
ASSETS_DIR=./assets
